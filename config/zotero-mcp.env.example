# Copy this file to your own shell profile, .env file, or MCP runtime config.
# Do not commit real keys.

# Local Zotero Desktop read mode. Local API library ID is usually 0.
ZOTERO_LOCAL=true
ZOTERO_LOCAL_LIBRARY_ID=0

# Web API write mode. Replace with your zotero.org numeric user or group ID.
ZOTERO_LIBRARY_ID=YOUR_ZOTERO_USER_OR_GROUP_ID
ZOTERO_LIBRARY_TYPE=user

# Prefer a key file over placing the secret directly in config.
ZOTERO_API_KEY_FILE=/absolute/path/outside/this/repo/zotero_api_key.txt

# Optional: keep MCP logs plain and stable for agent clients.
ZOTERO_NO_CLAUDE=true
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
FASTMCP_SHOW_SERVER_BANNER=false
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_ENABLE_RICH_LOGGING=false
FASTMCP_ENABLE_RICH_TRACEBACKS=false
FASTMCP_LOG_LEVEL=ERROR

